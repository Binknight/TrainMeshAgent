# OpenAI API Configuration
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_SSL_VERIFY=true
# 外部网络代理（访问 LLM API / HuggingFace / ModelScope，如 http://proxy.company.com:8080）
EXTERNAL_PROXY=

# ── 数据库 ──
# 默认后端是 **SQLite**（单文件，无需任何外部服务）。后端由 DATABASE_URL 的
# 前缀自动侦测，因此不需要额外的开关：
#   DATABASE_URL 以 postgres:// 或 postgresql:// 开头  →  PostgreSQL（逃生门）
#   其余（留空 / 未设置 / 其他）                        →  SQLite（默认）
#
#   1) 默认：留空即可，数据落到下面 SQLITE_PATH 指定的文件。
#   2) 外部 PostgreSQL（可选）：填写连接串即切换后端，同一份代码无需改动。
#      postgresql://user:pass@127.0.0.1:5432/train_mesh_agent
#      注意：非空但前缀不是 postgres:// 的串会被**静默**当成 SQLite，
#      这是最容易误判的配置错误。
DATABASE_URL=

# SQLite 数据文件路径（默认后端使用）。
# 容器内由镜像 ENV 钉在挂载目录里：/home/aicm/db/train_mesh_agent.db
# WAL 模式下同目录还会有 -wal / -shm 两个伴生文件，备份需整目录拷贝。
# SQLITE_PATH=/home/aicm/db/train_mesh_agent.db

# SQLite 写锁等待上限（毫秒）。WAL 是库级单写者，并发写靠这个等待而非立刻报错。
# SQLITE_BUSY_TIMEOUT_MS=5000

# SQLite 同步级别：OFF / NORMAL / FULL / EXTRA。
# NORMAL 在 WAL 下只在 checkpoint 时 fsync，极端掉电可能丢最后若干事务
# （会话历史非关键数据，这是有意的折衷）。
# SQLITE_SYNCHRONOUS=NORMAL

# 本地开发时豁免「数据库目录必须在挂载点下」的自检（会打印醒目告警）。仅限本地。
# DB_ALLOW_LOCAL=1

# 仅 PG 逃生门相关（用外部 PostgreSQL 时才会读取；SQLite 下忽略）
# PGDATA=/home/aicm/db/data
# PG_SOCKET_DIR=/home/aicm/db/run

# MCP Simulation Server
MCP_SERVER_URL=http://localhost:9000

# ── MCP 仿真 Server 并发控制（变量前缀 AICM_MCP_，由 mcp_server/config.py 读取）──
# 同时运行的仿真子进程上限。1 对仿真 = 2 个任务（原始组网 + 等效组网），
# 超出上限的任务按 FIFO 排队（status=queued，report_status 返回 queue_position）。
# 默认 2 = 1 对并发（先保证单对任务跑稳）；实际能力取决于单对仿真的 CPU/内存开销，
# 压测确认有余量后再调大。
AICM_MCP_MAX_CONCURRENT_TASKS=2
# 单任务执行超时（秒）：超时 kill 整个仿真进程组并置 failed，避免挂死任务永久占槽。
AICM_MCP_TASK_TIMEOUT_SEC=3600
# 排队超时（秒）：排队超过该时长仍未拿到槽位则置 failed，避免无限等待。
AICM_MCP_QUEUE_TIMEOUT_SEC=900
# 队列上限（背压）：排队中的任务最多 N 个（运行中任务不占这个名额）；超出时
# execute_task 返回 JSON-RPC error code -32004（消息含「队列已满」），Flask 转成
# HTTP 429 simulation_queue_full，前端提示稍后重试且不会把任务标失败。
AICM_MCP_MAX_QUEUE_SIZE=20

# ── MCP 工作区磁盘清理（③；由 mcp_server/services/workspace_cleaner.py 执行）──
# 优先级（从高到低）：运行中/排队中任务永不删 > 磁盘应急水位 > min_keep_tasks
# > workspace_retention_days。正常水位下两个保留配置冲突时，min_keep_tasks 赢
# （保留更多）；磁盘 >= 水位线时水位规则接管（两条常规配置一起让位）。
# 1) 正常水位：结果目录 results/ 保留 7 天（先删它释放空间）；日志/脚本/task_meta
#    再保留到 14 天，然后删整个任务目录。
AICM_MCP_WORKSPACE_RETENTION_DAYS=7
AICM_MCP_LOG_RETENTION_DAYS=14
# 2) 最近 N 个终态任务无论如何保留（默认 20）；防止“很久没跑任务后把仅存的历史清光”。
AICM_MCP_MIN_KEEP_TASKS=20
# 3) 磁盘水位：>=80% 进入应急模式（保留期 2 天、必留 5 个）；
#    >=90% 进入临界模式（只保留最新 1 个任务，尽快止血）。
AICM_MCP_DISK_WATERMARK_PCT=80
AICM_MCP_DISK_CRITICAL_PCT=90
AICM_MCP_EMERGENCY_RETENTION_DAYS=2
AICM_MCP_EMERGENCY_MIN_KEEP_TASKS=5
# 4) 清理频率：服务启动后先等 10s 扫一次，之后每 24h 扫一次。
AICM_MCP_CLEANUP_INTERVAL_HOURS=24
AICM_MCP_CLEANUP_INITIAL_DELAY_SEC=10
# 只统计不删除（上线前观察用）；确认阈值合理后改回 false。
AICM_MCP_CLEANUP_DRY_RUN=false
# 需要彻底关闭清理时设为 false。
AICM_MCP_WORKSPACE_CLEANUP_ENABLED=true

# Simulation polling interval (seconds)
SIM_POLL_INTERVAL=1.0

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true
FLASK_USE_RELOADER=false

# OpenAI API Configuration
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_SSL_VERIFY=true
# 外部网络代理（访问 LLM API / HuggingFace / ModelScope，如 http://proxy.company.com:8080）
EXTERNAL_PROXY=

# ── PostgreSQL ──
# 两种形态，按运行环境选一种：
#
#   1) 本地开发（本机已装 PostgreSQL，默认值即可，无需取消注释）：
#      postgresql://postgres:postgres@127.0.0.1:5432/train_mesh_agent
#      注意：本地 PG 的主版本与容器内嵌的 PG 14 不必一致，但两者数据文件、
#      pg_dump 产物跨版本**不可直接复用**，容器数据目录也不能跨主版本启动。
#
#   2) 容器内嵌（镜像 ENV 已提供该默认值，一般不用在这里写）：
#      postgresql://postgres@/train_mesh_agent?host=/home/aicm/db/run
#      空 hostname + host=/path 即走 Unix socket，不开 TCP。
#
# 留空/不设置 = 沿用 app/config.py 的默认值（TCP 连本机 5432）。
DATABASE_URL=

# 内嵌 PostgreSQL 数据目录与 socket 目录（仅容器内模式使用，镜像内已设默认值）
# PGDATA=/home/aicm/db/data
# PG_SOCKET_DIR=/home/aicm/db/run

# 本地开发时豁免「PGDATA 必须在挂载点下」的自检（会打印醒目告警）。仅限本地。
# DB_ALLOW_LOCAL=1

# MCP Simulation Server
MCP_SERVER_URL=http://localhost:9000

# Simulation polling interval (seconds)
SIM_POLL_INTERVAL=1.0

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true
FLASK_USE_RELOADER=false
